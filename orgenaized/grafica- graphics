
from kivy.app import App
from kivy.uix.floatlayout import FloatLayout
from kivy.uix.button import Button
from kivy.uix.gridlayout import GridLayout
from kivy.uix.label import Label
from kivy.uix.textinput import TextInput
import TicTacToe
import json
import os

class FirstScreen(FloatLayout):
    def __init__(self):
        FloatLayout.__init__(self)
        self.graphBoard = Board()
        self.addOn()
        self.addLabel()
        self.addTextInput()
        self.addButton()

    def addOn(self):
        self.graphBoard.size_hint = (.5, .5)
        self.graphBoard.pos_hint = {"center_x": .5, "center_y": .7}
        self.add_widget(self.graphBoard)

    def addLabel(self):
        self.turn = Label()
        self.turn.font_size = 30
        self.turn.color = '#00FF00'
        self.turn.text = "Lets play!"
        self.turn.size_hint = (.2, .1)
        self.turn.pos_hint= {"center_x": .1, "center_y": .5}
        self.add_widget(self.turn)

    def addTextInput(self):
        self.name = TextInput()
        self.name.text = "name?"
        self.name.multiline = False
        self.name.padding_y = (20, 20)
        self.name.size_hint = (.2, .1)
        self.name.bold = True
        self.name.background_color = '#00FFCE'
        self.name.background_normal = ""
        self.name.pos_hint = {"center_x": .3, "center_y": .1}
        self.add_widget(self.name)

    def addButton(self):
        self.buttonRestart = Button()
        self.buttonRestart.text = "refresh"
        self.buttonRestart.pos_hint = {"center_x": .1, "center_y": .2}
        self.buttonRestart.size_hint = (.2, .1)
        self.buttonRestart.bind(on_press = self.restart_game)
        self.add_widget(self.buttonRestart)

    def react(self,touched):
        touched.text = "ooooh"

    def restart_game(self, touched):
        # מפעיל את פונקציית האיפוס בלוח המשחק
        self.graphBoard.reset_board()


class Cell(Button):  # MAKING A BUTTON WITH A '?' PICTURE
    def __init__(self, row, col):
        Button.__init__(self)
        self.text = ""
        self.row = row
        self.col = col
        # self.background_normal = 'QuestionMark.png'

    def on_press(self):
        if self.parent.finished == False:
            self.parent.check(self.row, self.col)

class Board(GridLayout):

    def __init__(self):
        GridLayout.__init__(self)
        self.cols = 4
        self.listGraphBoard = []

        # יצירת נתיב דינמי ואוטומטי לקובץ ה-JSON באותה התיקייה
        script_dir = os.path.dirname(os.path.abspath(__file__))
        json_path = os.path.join(script_dir, "dict.json")
        #יוצר מופע של משחק
        self.myGame = TicTacToe.Game(json_path)
        self.addCellsToBoatd()
        #calls the agent which means it starts
        self.agent()
        self.finished = False

    #agent move
    def agent(self):
        row, col = self.myGame.agent_move()
        if row!=-1 and col!=-1:
            self.listGraphBoard[row][col].text = '1'
        else:
            print("Draw")
        if self.myGame.check_win(1)==True:
            print("The agent won!")
            self.finished = True
            self.final_label(1)

    def addCellsToBoatd(self):
        for line in range(4):
            newLine = []
            for col in range(4):
                temp_cell = Cell(line, col)
                self.add_widget(temp_cell)
                newLine.append(temp_cell)
            self.listGraphBoard.append(newLine)

    def check(self, row, col):
        answer = self.myGame.player_from_graphics(row, col)
        if answer==True:
            self.listGraphBoard[row][col].text = '2'
            if_is_win = self.myGame.check_win(-1)

            if not if_is_win:
                self.agent()
                if not self.myGame.available_places:
                    self.finished = True
                    self.final_label(0)
            else:
                self.finished = True
                self.final_label(2)

    def final_label(self, won):
        self.turn = Label()
        self.turn.size_hint = (1, 0.15)
        self.turn.pos_hint = {"center_x": 0.5, "center_y": 0.35}
        self.turn.font_size = 100
        self.turn.color = '#0000FF'
        if won == 1:
            self.turn.text = "The agent won!"
        elif won == 2:
            self.turn.text = "The player won!"
        else:
            self.turn.text = "It's a draw!"

        self.parent.add_widget(self.turn)

    def reset_board(self):
        """מאפס את המשחק כולו להתחלה"""
        # 1. יצירת אובייקט משחק חדש (מנקה את הלוגיקה)
        #will be used when the dict will be connected
        script_dir = os.path.dirname(os.path.abspath(__file__))
        json_path = os.path.join(script_dir, "dict.json")

       #creates a new game
        self.myGame = TicTacToe.Game(json_path)

        self.finished = False

        # 2. איפוס הטקסט בכל המשבצות בלוח הגרפי
        for line in self.listGraphBoard:
            for cell in line:
                cell.text = ""

        # 3. הסרת הודעת הסיום (הלייבל הגדול) אם היא קיימת על המסך
        # אנחנו מחפשים ווידג'טים שהם Label ומוחקים אותם כדי שלא יערמו
        children_to_remove = []
        for widget in self.parent.children:
            if isinstance(widget, Label) and widget != self.parent.turn and widget != self.parent.buttonRestart:
                children_to_remove.append(widget)
        for widget in children_to_remove:
            self.parent.remove_widget(widget)

        # 4. מתן תור ראשון מחדש לסוכן
        self.agent()

    def react(self):
        pass

class MyPaintApp(App):
    def build(self):
        return FirstScreen()


MyPaintApp().run()
