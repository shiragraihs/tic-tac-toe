    def rating(self):
        grade=self.winner
        if grade== 0:
            grade=0.1

        #list[start : stop : step]
        reversed_history = self.history[::-1]

        self.rated_boards=[]

        for i in range(len(reversed_history)):
            board=reversed_history[i]

            self.rated_boards.append((board,grade))

            grade *= 0.9

        return self.rated_boards

    #dictionary
    def board_to_str(self, board):
        str_board = ""
        for i in range(4):
            for j in range(4):
                # Convert values to characters or symbols for the string
                val = board[i][j]
                if val == -1: #instead of -1 we'll write the num 2 in order to create a string 16 digits long
                    str_board += "2"
                elif val == 1:
                    str_board += "1"
                else:
                    str_board += "0"
        return str_board

    def str_to_board(self, str_board):
        board = []
        adding = []
        for i in range(len(str_board)):
            char = str_board[i]
            if char == '2':
                adding.append(-1)
            elif char == '1':
                adding.append(1)
            else:
                adding.append(0)

            if len(adding) == 4:
                board.append(adding)
                adding = []
        return board

    def history_with_str (self):
        grade = self.winner
        if grade == 0:
            grade = 0.1

        # list[start : stop : step]
        reversed_history = self.history[::-1]

        self.rated_str_boards = []

        for i in range(len(reversed_history)):
            board = self.board_to_str(self.merge(reversed_history[i]))

            self.rated_str_boards.append((board, grade))
            grade *= 0.9

        return self.rated_str_boards

#no doubles
    def rotate(self, g): # 90 degrees each time
        return tuple(zip(*g[::-1]))

    def flip_horizontal(self, g): #right to left
        return tuple(row[::-1] for row in g)

    def merge (self, b1): #saves only the specific potision of the board
        symmetries = []
        curr = b1

        # 2. Loop through all 4 rotational phases, adding both normal and flipped states
        for _ in range(4):
            symmetries.append(curr)
            symmetries.append(self.flip_horizontal(curr))
            curr = self.rotate(curr)

        # 3. Flatten each 4x4 grid symmetry back into a 16-element flat tuple
        flat_symmetries = [
            tuple(cell for row in s for cell in row)
            for s in symmetries
        ]

        # 4. Pick and return the lexicographically smallest one as the unique key
        #meaning saves the board,
        #compares numbers numerically rather than alphabetically. The rules are straightforward:
            # -1 is the smallest.
            # 0 is in the middle.
            # 1 is the largest.

        board=min(flat_symmetries)

        return [list(board[i * 4: (i + 1) * 4]) for i in range(4)]
#much safisticated
#1. uses dict if there is no wining move or lose position

    def use_dict(self):
        #שימוש במילון אם יש אשפרות
        best_index = self.find_best()

        if best_index != -1 and not self.finished and len(self.available_places)>0:

            # המרת האינדקס השטוח לשורה ועמודה במטריצה (למשל בלוח 4x4)
            row = best_index // 4
            col = best_index % 4

            return row, col

        else:
            return -1,-1;

    def find_best(self):
        #עושה נסיונות שונים להחלפת האפסים שבמחרוזת הלוח על מנת למצוא את האפשרות הטובה ביותר למהלך הבא
        board_str= self.board_to_str(self.board)
        board_list = list(board_str)

        cur=0
        max_grade=-float('inf') # מתחילים ממינוס אינסוף
        best_index = -1

        for i in range(len(board_list)):
            temp = list(board_list) #כדי לא ליצור הצבעה אחרת עושים כך
            if board_list[i] == '0':
                temp[i]='1'

                temp_str = "".join(temp)
                if temp_str in self.dict:
                    cur= self.dict[temp_str][0] #cur_grade

                    if cur > max_grade:
                        max_grade = cur
                        best_index = i

        return best_index

    def has_half(self):
        if not self.dict:
            return False

        poten=len(self.available_places)
        if poten ==0:
            return False

        # עושה נסיונות שונים להחלפת האפסים שבמחרוזת הלוח על מנת למצוא את האפשרות הטובה ביותר למהלך הבא
        board_str = self.board_to_str(self.board)
        board_list = list(board_str)

        count = 0

        # מעבר ישיר על המשבצות הפנויות במקום לסרוק את כל הלוח        for row, col in self.available_places:
        # דרך ממש מגניבה
        for row, col in self.available_places:
            idx = row * 4 + col
            temp = list(board_list)
            temp[idx] = '1'
            temp_str = "".join(temp)

            if temp_str in self.dict:
                count+=1  # בודק האם קיים במילון שלי ,קיים- מוסיף 1 לספירה

        return poten / 2 < count #אם יש לי יותר מחצי מהאופציות בפוזציה אז יחזיר נכון


