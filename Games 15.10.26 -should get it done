
class Games:
    def __init__(self):
        self.dict = {}

    def add_to_dictionary(self, g):
        for n in range(len(g.rated_str_boards)):
            if g.rated_str_boards[n] in self.dict:

                key=g.rated_str_boards[n][0]
                avg, count = self.dict[key]

                new_avg = (avg * count + ) / (count + 1)
                new_count = count + 1

                self.board_scores[key] = (new_avg, new_count)
