import json
import matplotlib.pyplot as plt

from game import Game  # תחליפי את 'game' בשם הקובץ האמיתי שלך אם הוא שונה

class Games:
    def __init__(self):
        self.dict = {}

    def add_to_dictionary(self, g):
        for item in g.rated_str_boards:
            grade = item[1]  # הציון של הלוח
            key = item[0]
            if key in self.dict:  # already exists
                avg, count = self.dict[key]
                new_avg = ((avg * count) + grade) / (count + 1)
                new_count = count + 1
                self.dict[key] = [new_avg, new_count]
            else:
                self.dict[key] = [grade, 1]

    # 1. checks if string is actually 16 digs
    def all16(self):
        ret = True
        for key in self.dict:
            if not len(key) == 16:
                ret = False
                break
        return ret

    # 2. checks if it was a win and there weren't bugs
    def won(self):
        temp_g = Game()
        ret = True
        for key, value in self.dict.items():
            grade = value[0]
            if grade >= 0.99:
                temp_g.board = temp_g.str_to_board(key)
                ret = temp_g.check_win(1)
        return ret

    # 3. checks that each board that the AGENT is about to win has high grade
    def near_win_high_grade(self):
        temp_g = Game()

        for key, value in self.dict.items():
            grade = value[0]  # הציון הממוצע של הלוח
            board = temp_g.str_to_board(key)

            is_near_win = False

            # 1. בדיקת שורות
            for row in board:
                if row.count(1) == 3 and row.count(0) == 1 and row.count(-1) == 0:
                    is_near_win = True
                    break

            # 2. בדיקת עמודות
            if not is_near_win:
                for col_idx in range(4):
                    col = [board[row_idx][col_idx] for row_idx in range(4)]
                    if col.count(1) == 3 and col.count(0) == 1 and col.count(-1) == 0:
                        is_near_win = True
                        break

            # 3. בדיקת אלכסון ראשי
            if not is_near_win:
                main_diag = [board[i][i] for i in range(4)]
                if main_diag.count(1) == 3 and main_diag.count(0) == 1 and main_diag.count(-1) == 0:
                    is_near_win = True

            # 4. בדיקת אלכסון משני
            if not is_near_win:
                anti_diag = [board[i][3 - i] for i in range(4)]
                if anti_diag.count(1) == 3 and anti_diag.count(0) == 1 and anti_diag.count(-1) == 0:
                    is_near_win = True

            if is_near_win:
                if grade < 0:
                    return False  # באג! לוח רגע לפני ניצחון קיבל ציון נמוך מדי

        return True

    # 5. checks that there are only 0,1,2 in the strings
    def valid_characters(self):
        allowed_chars = {'0', '1', '2'}

        for key in self.dict:
            for char in key:
                if char not in allowed_chars:
                    return False

        return True

    # 6. התפלגות ציונים וגרף
    def plot_score_distribution(self):
        grades = [value[0] for value in self.dict.values()]

        if not grades:
            print("המילון ריק, אין עדיין ציונים להציג בגרף.")
            return

        try:
            plt.figure(figsize=(9, 5))
            plt.hist(grades, bins=10, color='royalblue', edgecolor='black', alpha=0.8)
            plt.title("Score Distribution of Tic-Tac-Toe Agent States", fontsize=14, fontweight='bold')
            plt.xlabel("State Grade Value", fontsize=12)
            plt.ylabel("Number of States (Frequency)", fontsize=12)
            plt.grid(axis='y', linestyle='--', alpha=0.6)
            plt.show()
        except Exception as e:
            print(f"שגיאה בהצגת הגרף: {e}")

    # 8. checks that the amount of moves of the agent is plus minus 1 compared to the player moves
    def validate_turn_order(self):
        """
        סעיף 8: בדיקת חוקיות תורות (Turn-order legality).
        """
        for board_str in self.dict.keys():
            count_player = board_str.count('2')
            count_agent = board_str.count('1')

            if not (count_player <= count_agent <= count_player + 1):
                return False

        return True

    # 9. checks that each board that the PLAYER is about to win has low grade
    def near_lose_low_grade(self):
        temp_g = Game()

        for key, value in self.dict.items():
            grade = value[0]
            board = temp_g.str_to_board(key)

            is_near_win = False

            # 1. בדיקת שורות
            for row in board:
                if row.count(-1) == 3 and row.count(0) == 1 and row.count(1) == 0:
                    is_near_win = True
                    break

            # 2. בדיקת עמודות
            if not is_near_win:
                for col_idx in range(4):
                    col = [board[row_idx][col_idx] for row_idx in range(4)]
                    if col.count(-1) == 3 and col.count(0) == 1 and col.count(1) == 0:
                        is_near_win = True
                        break

            # 3. בדיקת אלכסון ראשי
            if not is_near_win:
                main_diag = [board[i][i] for i in range(4)]
                if main_diag.count(-1) == 3 and main_diag.count(0) == 1 and main_diag.count(1) == 0:
                    is_near_win = True

            # 4. בדיקת אלכסון משני
            if not is_near_win:
                anti_diag = [board[i][3 - i] for i in range(4)]
                if anti_diag.count(-1) == 3 and anti_diag.count(0) == 1 and anti_diag.count(1) == 0:
                    is_near_win = True

            if is_near_win:
                if grade > 0:
                    return False  # באג! לוח רגע לפני הפסד קיבל ציון חיובי בטעות

        return True

    @staticmethod
    def train_and_save_random_games(num_games=300000, filename="tic_tac_toe_300k.json"):
        """
        מריץ 300,000 משחקים אקראיים לחלוטין (בלי חתירה לניצחון או מניעת הפסד),
        בונה את מילון המצבים הכולל סימטריות וממוצעים מתגלגלים, ושומר לקובץ JSON.
        """
        knowledge_base = {}

        print(f"התחלת אימון אקראי של {num_games} משחקים...")

        for game_idx in range(num_games):
            game = Game()

            while not game.finished:
                if not game.agent_move():
                    break
                if game.check_win(1):
                    game.winner = 1
                    break
                if not game.available_places:
                    game.finished = True
                    game.winner = 0
                    break

                if not game.player_move():
                    break
                if game.check_win(-1):
                    game.winner = -1
                    break
                if not game.available_places:
                    game.finished = True
                    game.winner = 0
                    break

            rated_boards = game.historty_with_str()

            for board_str, grade in rated_boards:
                if board_str not in knowledge_base:
                    knowledge_base[board_str] = [0.0, 0]

                grade_sum, count = knowledge_base[board_str]
                count += 1
                new_grade = grade_sum + (grade - grade_sum) / count
                knowledge_base[board_str] = [new_grade, count]

            if (game_idx + 1) % 50000 == 0:
                print(f"הושלמו {game_idx + 1} משחקים...")

        with open(filename, 'w', encoding='utf-8') as f:
            json.dump(knowledge_base, f, ensure_ascii=False, indent=4)

        print(f"האימון הסתיים בהצלחה! סך הכל מצבים ייחודיים במילון: {len(knowledge_base)}")
        print(f"המידע נשמר בקובץ: {filename}")
        return knowledge_base


# בלוק ההרצה ממוקם כאן בחוץ, מחוץ למחלקה ובשורה הראשונה משמאל:
if __name__ == "__main__":
    Games.train_and_save_random_games(num_games=300000, filename="tic_tac_toe_300k.json")
